[Unit]
Description=httpjet web server (generic static installation)
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
User=httpjet
Group=httpjet
RuntimeDirectory=httpjet
RuntimeDirectoryMode=0750
StateDirectory=httpjet
StateDirectoryMode=0750
LogsDirectory=httpjet
LogsDirectoryMode=0750
WorkingDirectory=/var/lib/httpjet
ExecStartPre=/usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin /usr/local/bin/httpjet --root /etc/httpjet check --strict
ExecStart=/opt/httpjet/libexec/launch
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027
Restart=on-failure
RestartSec=2
TimeoutStartSec=30
TimeoutStopSec=30
KillMode=mixed
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
