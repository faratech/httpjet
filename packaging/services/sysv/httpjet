#!/bin/sh
### BEGIN INIT INFO
# Provides:          httpjet
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: httpjet web server
### END INIT INFO
case "${1:-}" in
 start) exec /opt/httpjet/libexec/control direct-start ;;
 stop) exec /opt/httpjet/libexec/control direct-stop ;;
 restart|force-reload) /opt/httpjet/libexec/control direct-stop && exec /opt/httpjet/libexec/control direct-start ;;
 status) exec /opt/httpjet/libexec/control status ;;
 *) echo "usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
