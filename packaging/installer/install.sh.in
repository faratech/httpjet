#!/bin/sh
# Rendered by the release publisher with its verified public archive key.
set -eu
PATH='/usr/sbin:/usr/bin:/sbin:/bin'
export PATH
umask 077

# Fixed in the published installer; the tests rewrite this line in a private copy.
FILESYSTEM_ROOT=''
REPOSITORY_URL='@HTTPJET_REPOSITORY_URL@'
ARCHIVE_KEY_FINGERPRINT='@HTTPJET_ARCHIVE_KEY_FINGERPRINT@'
HTTPJET_REQUESTED_VERSION=''
HTTPJET_METHOD=auto
HTTPJET_INIT=auto
RELEASE_BASE_URL='@HTTPJET_RELEASE_BASE_URL@'
MANAGED=0
WORK_DIR=''
ATOMIC_TEMP=''
SHOW_JOURNAL=0
CREATED_SOURCE=0
CREATED_KEYRING=0
PACKAGE_INSTALL_STARTED=0
SOURCE_FILE=''
KEYRING_FILE=''

message() { printf '%s\n' "httpjet: $*"; }
fail() { message "$*" >&2; exit 1; }

usage() {
    cat <<'USAGE'
Usage: install.sh [--method auto|package|binary] [--init auto|systemd|openrc|runit|sysv|none] [--version X.Y.Z-N]

Install a signed native APT/RPM package or a signed static binary on mutable
Linux (amd64/arm64). Working io_uring is mandatory. Unknown supervisors need
explicit --init none. Existing ownership, configuration, content and stopped
service states are preserved. NixOS/Guix use declarative integrations.
USAGE
}

embedded_archive_key() {
    cat <<'HTTPJET_ARCHIVE_KEY'
@HTTPJET_ARCHIVE_PUBLIC_KEY@
HTTPJET_ARCHIVE_KEY
}

cleanup() {
    result=$?
    trap - 0
    if [ "$result" -ne 0 ] && [ "$SHOW_JOURNAL" -eq 1 ]; then
        message 'Recent service diagnostics:' >&2
        timeout -k 1 5 journalctl --unit httpjet.service --lines 40 --no-pager >&2 || :
    fi
    # Before a package transaction starts, undo only files created by this run
    # whose bytes still match ours. A concurrent administrator's edits survive.
    if [ "$result" -ne 0 ] && [ "$PACKAGE_INSTALL_STARTED" -eq 0 ] && [ -n "$WORK_DIR" ]; then
        if [ "$CREATED_SOURCE" -eq 1 ] && cmp -s "$WORK_DIR/httpjet.sources" "$SOURCE_FILE"; then
            rm -f -- "$SOURCE_FILE"
        fi
        if [ "$CREATED_KEYRING" -eq 1 ] && cmp -s "$WORK_DIR/archive-key.asc" "$KEYRING_FILE"; then
            rm -f -- "$KEYRING_FILE"
        fi
    fi
    if [ -n "$ATOMIC_TEMP" ]; then rm -f -- "$ATOMIC_TEMP"; fi
    if [ -n "$WORK_DIR" ]; then rm -rf -- "$WORK_DIR"; fi
    exit "$result"
}
trap cleanup 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

while [ "$#" -gt 0 ]; do
    case "$1" in
        --help|-h) usage; exit 0 ;;
        --method|--init)
            [ "$#" -ge 2 ] || fail "$1 needs a value"
            case "$1:$2" in
                --method:auto|--method:package|--method:binary) HTTPJET_METHOD=$2 ;;
                --init:auto|--init:systemd|--init:openrc|--init:runit|--init:sysv|--init:none) HTTPJET_INIT=$2 ;;
                *) fail "invalid $1 value: $2" ;;
            esac
            shift 2
            ;;
        --version)
            [ "$#" -ge 2 ] || fail '--version needs X.Y.Z-N'
            [ -z "$HTTPJET_REQUESTED_VERSION" ] || fail '--version may only be supplied once'
            HTTPJET_REQUESTED_VERSION=$2
            shift 2
            printf '%s\n' "$HTTPJET_REQUESTED_VERSION" | awk '/^[0-9]+\.[0-9]+\.[0-9]+-[0-9]+$/ { valid=1 } END { exit !valid }' \
                || fail 'invalid version; expected X.Y.Z-N'
            ;;
        *) fail "unknown argument: $1 (use --help)" ;;
    esac
done

# An unrendered source template must fail before touching the host.
case "$REPOSITORY_URL" in
    https://?*) ;;
    *) fail 'this installer has not been rendered for an HTTPS archive' ;;
esac
case "$REPOSITORY_URL" in
    *[!A-Za-z0-9:/._-]*) fail 'invalid rendered HTTPS archive URL' ;;
esac
case "$ARCHIVE_KEY_FINGERPRINT" in
    ''|*[!0-9A-F]*) fail 'missing or invalid embedded archive key fingerprint' ;;
esac
case "${#ARCHIVE_KEY_FINGERPRINT}" in
    40|64) ;;
    *) fail 'missing or invalid embedded archive key fingerprint' ;;
esac
case "$(embedded_archive_key)" in
    '-----BEGIN PGP PUBLIC KEY BLOCK-----'*'-----END PGP PUBLIC KEY BLOCK-----') ;;
    *) fail 'this installer has no embedded public archive key' ;;
esac


install_apt() {
for required in apt-get dpkg dpkg-query systemctl timeout awk; do
 command -v "$required" >/dev/null 2>&1 || fail "required command is unavailable: $required"
done
[ "$(dpkg --print-architecture)" = "$ARCHITECTURE" ] || fail "unsupported mixed package/kernel architecture"
timeout -k 1 5 systemctl show --property=Version --value >/dev/null 2>&1 || fail "cannot communicate with systemd"
package_status=$(dpkg-query -W '-f=${Status}' httpjet 2>/dev/null || :)
case "$package_status" in
    'install ok installed') MANAGED=1 ;;
    ''|'deinstall ok config-files') ;;
    *) fail "httpjet has an incomplete package state ($package_status); repair it with APT before retrying" ;;
esac

if [ "$MANAGED" -eq 0 ]; then
    for existing in \
        "$FILESYSTEM_ROOT/etc/httpjet" \
        "$FILESYSTEM_ROOT/etc/default/httpjet" \
        "$FILESYSTEM_ROOT/var/www/httpjet" \
        "$FILESYSTEM_ROOT/usr/bin/httpjet" \
        "$FILESYSTEM_ROOT/usr/sbin/httpjet" \
        "$FILESYSTEM_ROOT/usr/local/bin/httpjet" \
        "$FILESYSTEM_ROOT/usr/local/sbin/httpjet" \
        "$FILESYSTEM_ROOT/usr/local/httpjet/bin/httpjet" \
        "$FILESYSTEM_ROOT/usr/local/lib/systemd/system/httpjet.service" \
        "$FILESYSTEM_ROOT/etc/systemd/system/httpjet.service" \
        "$FILESYSTEM_ROOT/etc/systemd/system/httpjet.service.d" \
        "$FILESYSTEM_ROOT/etc/systemd/system/httpjet.socket" \
        "$FILESYSTEM_ROOT/lib/systemd/system/httpjet.service" \
        "$FILESYSTEM_ROOT/usr/lib/systemd/system/httpjet.service"; do
        if [ -e "$existing" ] || [ -L "$existing" ]; then
            fail "existing unmanaged httpjet path: $existing; migrate it explicitly before using this installer"
        fi
    done
    load_state=$(timeout -k 1 5 systemctl show --property=LoadState --value httpjet.service 2>/dev/null) \
        || fail 'cannot inspect the existing httpjet service'
    case "$load_state" in
        ''|not-found) ;;
        *) fail "an unmanaged httpjet service is already known to systemd ($load_state)" ;;
    esac

    # Check before dependency/repository changes. /proc is a fallback when a
    # minimal image has not installed iproute2 yet; neither path changes sysctls.
    if command -v ss >/dev/null 2>&1; then
        listeners=$(ss -H -ltn 'sport = :80') || fail 'cannot inspect TCP port 80'
        [ -z "$listeners" ] || fail 'TCP port 80 is occupied; this installer will not stop the existing server'
    else
        [ -r "$FILESYSTEM_ROOT/proc/net/tcp" ] || fail 'cannot inspect TCP port 80 (/proc/net/tcp is unavailable)'
        set -- "$FILESYSTEM_ROOT/proc/net/tcp"
        if [ -r "$FILESYSTEM_ROOT/proc/net/tcp6" ]; then set -- "$@" "$FILESYSTEM_ROOT/proc/net/tcp6"; fi
        listeners=$(awk '$2 ~ /:0050$/ && $4 == "0A" { print }' "$@") \
            || fail 'cannot inspect TCP port 80 in /proc'
        [ -z "$listeners" ] || fail 'TCP port 80 is occupied; this installer will not stop the existing server'
    fi
fi

SOURCE_FILE="$FILESYSTEM_ROOT/etc/apt/sources.list.d/httpjet.sources"
KEYRING_FILE="$FILESYSTEM_ROOT/usr/share/keyrings/httpjet-archive-keyring.asc"
for destination in "$SOURCE_FILE" "$KEYRING_FILE"; do
    [ ! -L "$destination" ] || fail "refusing a symbolic-link destination: $destination"
    if [ -e "$destination" ] && [ ! -f "$destination" ]; then
        fail "expected a regular file: $destination"
    fi
done

WORK_DIR=$(mktemp -d "$FILESYSTEM_ROOT/tmp/httpjet-install.XXXXXX")
embedded_archive_key >"$WORK_DIR/archive-key.asc"
cat >"$WORK_DIR/httpjet.sources" <<SOURCE
Types: deb
URIs: $REPOSITORY_URL
Suites: stable
Components: main
Architectures: $ARCHITECTURE
Signed-By: /usr/share/keyrings/httpjet-archive-keyring.asc
SOURCE
if [ -f "$SOURCE_FILE" ] && ! cmp -s "$WORK_DIR/httpjet.sources" "$SOURCE_FILE"; then
    fail "$SOURCE_FILE contains a different repository configuration; review it before retrying"
fi
if [ -f "$KEYRING_FILE" ] && ! cmp -s "$WORK_DIR/archive-key.asc" "$KEYRING_FILE"; then
    owner=$(dpkg-query -S /usr/share/keyrings/httpjet-archive-keyring.asc 2>/dev/null || :)
    case "$owner" in
        'httpjet-archive-keyring: '*) ;;
        *) fail "$KEYRING_FILE contains an unmanaged archive key; review it before retrying" ;;
    esac
fi

# Only install missing bootstrap prerequisites after the non-mutating checks.
if ! command -v curl >/dev/null 2>&1 || ! command -v ss >/dev/null 2>&1 \
    || [ ! -s "$FILESYSTEM_ROOT/etc/ssl/certs/ca-certificates.crt" ]; then
    message 'Installing HTTPS and network-inspection prerequisites.'
    apt-get update --error-on=any || fail 'APT could not refresh the existing distribution repositories'
    DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends ca-certificates curl iproute2 \
        || fail 'APT could not install the bootstrap prerequisites'
fi

atomic_install() {
    staged=$1
    destination=$2
    if [ -f "$destination" ] && cmp -s "$staged" "$destination"; then return; fi
    parent=${destination%/*}
    if [ ! -d "$parent" ]; then install -d -m 0755 "$parent"; fi
    ATOMIC_TEMP=$(mktemp "$parent/.httpjet-install.XXXXXX")
    install -m 0644 "$staged" "$ATOMIC_TEMP"
    mv -f -- "$ATOMIC_TEMP" "$destination"
    ATOMIC_TEMP=''
}
if [ ! -f "$KEYRING_FILE" ]; then
    atomic_install "$WORK_DIR/archive-key.asc" "$KEYRING_FILE"
    CREATED_KEYRING=1
    message "Bootstrapped archive trust with key $ARCHIVE_KEY_FINGERPRINT."
fi
if [ ! -f "$SOURCE_FILE" ]; then
    atomic_install "$WORK_DIR/httpjet.sources" "$SOURCE_FILE"
    CREATED_SOURCE=1
fi
message 'Using the signed stable archive and its dedicated archive keyring.'
apt-get update --error-on=any || fail 'APT could not verify or refresh the signed httpjet archive'
set -- --yes --no-install-recommends \
    -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold
if [ -n "$HTTPJET_REQUESTED_VERSION" ]; then
    package="httpjet=$HTTPJET_REQUESTED_VERSION"
    set -- "$@" --allow-downgrades
else
    package=httpjet
fi
if [ "$MANAGED" -eq 0 ]; then SHOW_JOURNAL=1; fi
PACKAGE_INSTALL_STARTED=1
DEBIAN_FRONTEND=noninteractive apt-get install "$@" httpjet-archive-keyring "$package" \
    || fail 'APT could not install httpjet; review the package-manager output above'

if [ "$MANAGED" -eq 1 ]; then
    message 'Package installation complete. Existing sites and service enablement are retained by the package lifecycle.'
    exit 0
fi

# Package postinst starts a fresh service. Do not force-enable/start a managed
# rerun, which may intentionally be stopped or disabled or serve custom sites.
WELCOME_FILE="$FILESYSTEM_ROOT/usr/share/httpjet/welcome/index.html"
[ -s "$WELCOME_FILE" ] || fail 'the installed package is missing its canonical welcome page'
attempt=0
while [ "$attempt" -lt 15 ]; do
    attempt=$((attempt + 1))
    if timeout -k 1 2 systemctl is-active --quiet httpjet.service; then
        status=$(curl --silent --show-error --fail --noproxy '*' \
            --connect-timeout 1 --max-time 2 --output "$WORK_DIR/welcome.html" \
            --write-out '%{http_code}' http://127.0.0.1/ 2>"$WORK_DIR/probe-error") || status=''
        if [ "$status" = 200 ] && cmp -s "$WELCOME_FILE" "$WORK_DIR/welcome.html"; then
            SHOW_JOURNAL=0
            message 'httpjet is running on TCP port 80. The packaged welcome page passed the HTTP check.'
            message 'Configuration: /etc/httpjet/conf/httpd_config.xml; content: /var/www/httpjet'
            exit 0
        fi
    fi
    sleep 1
done
fail 'the fresh installation did not serve the exact welcome page within the bounded startup check; inspect systemctl status httpjet.service'

}

require_command() { command -v "$1" >/dev/null 2>&1 || fail "required command is unavailable: $1"; }

port_available() {
    if command -v ss >/dev/null 2>&1; then
        listeners=$(ss -H -ltn 'sport = :80') || fail 'cannot inspect TCP port 80'
    else
        [ -r "$FILESYSTEM_ROOT/proc/net/tcp" ] || fail 'cannot inspect /proc/net/tcp for port 80'
        set -- "$FILESYSTEM_ROOT/proc/net/tcp"
        if [ -r "$FILESYSTEM_ROOT/proc/net/tcp6" ]; then set -- "$@" "$FILESYSTEM_ROOT/proc/net/tcp6"; fi
        listeners=$(awk '$2 ~ /:0050$/ && $4 == "0A" { print }' "$@") || fail 'cannot inspect TCP port 80'
    fi
    [ -z "$listeners" ] || fail 'TCP port 80 is occupied; this installer will not stop another server'
}

fresh_guard() {
    for existing in /usr/bin/httpjet /usr/local/bin/httpjet /usr/local/sbin/httpjetctl /usr/local/httpjet/bin/httpjet \
        /etc/httpjet /var/www/httpjet /etc/systemd/system/httpjet.service /usr/lib/systemd/system/httpjet.service \
        /usr/local/lib/systemd/system/httpjet.service /etc/init.d/httpjet /etc/rc.d/rc.httpjet /etc/sv/httpjet; do
        if [ -e "$FILESYSTEM_ROOT$existing" ] || [ -L "$FILESYSTEM_ROOT$existing" ]; then
            fail "existing unmanaged httpjet path: $existing; migrate it explicitly"
        fi
    done
    port_available
}

atomic_file() {
    staged=$1
    destination=$2
    [ ! -L "$destination" ] || fail "refusing symlink destination: $destination"
    parent=${destination%/*}
    if [ ! -d "$parent" ]; then install -d -m 0755 "$parent"; fi
    ATOMIC_TEMP=$(mktemp "$parent/.httpjet-install.XXXXXX")
    install -m 0644 "$staged" "$ATOMIC_TEMP"
    mv -f "$ATOMIC_TEMP" "$destination"
    ATOMIC_TEMP=''
}

generic_prerequisites() {
    missing=0
    for requirement in curl python3 setpriv; do
        if ! command -v "$requirement" >/dev/null 2>&1; then missing=1; fi
    done
    if ! command -v gpg2 >/dev/null 2>&1 && ! command -v gpg >/dev/null 2>&1; then missing=1; fi
    if command -v setpriv >/dev/null 2>&1 && ! setpriv --help 2>&1 | grep -q -- --ambient-caps; then missing=1; fi
    if [ "$missing" -eq 1 ]; then
        if command -v apk >/dev/null 2>&1; then apk add --no-cache ca-certificates curl gnupg python3 util-linux
        elif command -v apt-get >/dev/null 2>&1; then
            apt-get update --error-on=any
            DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl gnupg python3 util-linux
        elif command -v dnf >/dev/null 2>&1; then dnf -y install ca-certificates curl gnupg2 python3 util-linux
        elif command -v yum >/dev/null 2>&1; then yum -y install ca-certificates curl gnupg2 python3 util-linux
        elif command -v zypper >/dev/null 2>&1; then zypper --non-interactive install ca-certificates curl gpg2 python3 util-linux
        elif command -v pacman >/dev/null 2>&1; then pacman --sync --noconfirm --needed ca-certificates curl gnupg python util-linux
        elif command -v xbps-install >/dev/null 2>&1; then xbps-install -Sy ca-certificates curl gnupg python3 util-linux
        else fail 'install CA certificates, curl, full GPG, Python3 and util-linux setpriv with ambient capabilities'; fi
    fi
    for requirement in curl python3 setpriv; do require_command "$requirement"; done
    command -v gpg2 >/dev/null 2>&1 || command -v gpg >/dev/null 2>&1 \
        || fail 'full GnuPG (gpg2 or gpg) is required'
    python3 -c 'import sys; assert sys.version_info >= (3, 8), "Python 3.8+ required"'
    setpriv --help 2>&1 | grep -q -- --ambient-caps || fail 'BusyBox setpriv lacks ambient caps; install util-linux setpriv'
}

install_binary() {
    if [ ! -f "$FILESYSTEM_ROOT/var/lib/httpjet-installer/state.json" ]; then fresh_guard; fi
    if command -v dpkg-query >/dev/null 2>&1; then
        native_status=$(dpkg-query -W '-f=${Status}' httpjet 2>/dev/null || :)
        [ "$native_status" != 'install ok installed' ] || fail 'native APT package owns httpjet; use --method package'
    fi
    if command -v rpm >/dev/null 2>&1 && rpm -q httpjet >/dev/null 2>&1; then fail 'native RPM package owns httpjet; use --method package'; fi
    generic_prerequisites
    WORK_DIR=$(mktemp -d "$FILESYSTEM_ROOT/tmp/httpjet-install.XXXXXX")
    embedded_archive_key >"$WORK_DIR/archive.asc"
    cat >"$WORK_DIR/manage.py" <<'HTTPJET_INSTALLER_PYTHON'
@HTTPJET_INSTALLER_PYTHON@
HTTPJET_INSTALLER_PYTHON
    case "$RELEASE_BASE_URL" in https://?*) ;; *) fail 'missing rendered HTTPS release base URL' ;; esac
    set -- bootstrap --base "$RELEASE_BASE_URL" --key "$WORK_DIR/archive.asc" --fingerprint "$ARCHIVE_KEY_FINGERPRINT" --init "$HTTPJET_INIT"
    if [ -n "$HTTPJET_REQUESTED_VERSION" ]; then set -- "$@" --version "$HTTPJET_REQUESTED_VERSION"; fi
    python3 -I "$WORK_DIR/manage.py" "$@"
}

install_rpm() {
    for required in rpm systemctl timeout; do require_command "$required"; done
    rpm_managed=0
    if rpm -q httpjet >/dev/null 2>&1; then rpm_managed=1; fi
    if [ "$rpm_managed" -eq 0 ]; then fresh_guard; fi
    timeout -k 1 5 systemctl show --property=Version --value >/dev/null 2>&1 || fail 'cannot communicate with systemd'
    WORK_DIR=$(mktemp -d "$FILESYSTEM_ROOT/tmp/httpjet-install.XXXXXX")
    KEYRING_FILE="$FILESYSTEM_ROOT/etc/pki/rpm-gpg/RPM-GPG-KEY-httpjet"
    SOURCE_FILE="$FILESYSTEM_ROOT/etc/yum.repos.d/httpjet.repo"
    if [ "$RPM_MANAGER" = zypper ]; then SOURCE_FILE="$FILESYSTEM_ROOT/etc/zypp/repos.d/httpjet.repo"; fi
    embedded_archive_key >"$WORK_DIR/archive-key.asc"
    rpm_arch=x86_64
    if [ "$ARCHITECTURE" = arm64 ]; then rpm_arch=aarch64; fi
    cat >"$WORK_DIR/httpjet.repo" <<RPM_SOURCE
[httpjet]
name=httpjet signed stable archive
baseurl=${REPOSITORY_URL%/apt}/rpm/$rpm_arch
enabled=1
gpgcheck=1
repo_gpgcheck=1
pkg_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-httpjet
RPM_SOURCE
    if [ -L "$SOURCE_FILE" ] || { [ -f "$SOURCE_FILE" ] && ! cmp -s "$SOURCE_FILE" "$WORK_DIR/httpjet.repo"; }; then fail 'existing RPM repository configuration differs; review it explicitly'; fi
    if [ -L "$KEYRING_FILE" ]; then fail 'RPM key destination is a symlink'; fi
    if [ -f "$KEYRING_FILE" ] && ! cmp -s "$KEYRING_FILE" "$WORK_DIR/archive-key.asc"; then
        owner=$(rpm -qf --qf '%{NAME}' "$KEYRING_FILE" 2>/dev/null || :)
        [ "$owner" = httpjet-archive-keyring ] || fail 'existing RPM archive key is unmanaged'
    fi
    if [ ! -f "$KEYRING_FILE" ]; then atomic_file "$WORK_DIR/archive-key.asc" "$KEYRING_FILE"; CREATED_KEYRING=1; fi
    if [ ! -f "$SOURCE_FILE" ]; then atomic_file "$WORK_DIR/httpjet.repo" "$SOURCE_FILE"; CREATED_SOURCE=1; fi
    rpm --import "$KEYRING_FILE"
    rpm_package=httpjet
    if [ -n "$HTTPJET_REQUESTED_VERSION" ]; then rpm_package="httpjet-$HTTPJET_REQUESTED_VERSION"; fi
    PACKAGE_INSTALL_STARTED=1
    SHOW_JOURNAL=1
    case "$RPM_MANAGER" in
        dnf|yum)
            "$RPM_MANAGER" -y --disablerepo='*' --enablerepo=httpjet --setopt=httpjet.repo_gpgcheck=1 --setopt=httpjet.gpgcheck=1 makecache
            rpm_action=install
            if [ "$rpm_managed" -eq 1 ] && [ -n "$HTTPJET_REQUESTED_VERSION" ]; then
                installed_version=$(rpm -q --qf '%{VERSION}-%{RELEASE}' httpjet)
                case "$installed_version" in *[!0-9.-]*) fail 'installed RPM version needs explicit migration' ;; esac
                comparison=$(rpm --eval "%{lua:print(rpm.vercmp(\"$installed_version\",\"$HTTPJET_REQUESTED_VERSION\"))}")
                if [ "$comparison" = 1 ]; then rpm_action=downgrade; fi
            fi
            "$RPM_MANAGER" -y --setopt=httpjet.repo_gpgcheck=1 --setopt=httpjet.gpgcheck=1 "$rpm_action" httpjet-archive-keyring "$rpm_package"
            ;;
        zypper)
            zypper --non-interactive --gpg-auto-import-keys refresh httpjet
            if [ -n "$HTTPJET_REQUESTED_VERSION" ]; then
                zypper --non-interactive install --oldpackage httpjet-archive-keyring "httpjet=$HTTPJET_REQUESTED_VERSION"
            else
                zypper --non-interactive install httpjet-archive-keyring httpjet
            fi
            ;;
    esac
    if [ "$rpm_managed" -eq 0 ]; then
        require_command curl
        attempt=0
        while [ "$attempt" -lt 15 ]; do
            attempt=$((attempt + 1))
            if timeout -k 1 2 systemctl is-active --quiet httpjet.service && curl --fail --silent --noproxy '*' --connect-timeout 1 --max-time 2 --output "$WORK_DIR/welcome.html" --write-out '%{http_code}' http://127.0.0.1/ >"$WORK_DIR/status" \
                && [ "$(cat "$WORK_DIR/status")" = 200 ] && cmp -s "$WORK_DIR/welcome.html" "$FILESYSTEM_ROOT/usr/share/httpjet/welcome/index.html"; then SHOW_JOURNAL=0; message 'RPM install passed exact welcome check'; return; fi
            sleep 1
        done
        fail 'fresh RPM installation failed bounded service/welcome check'
    fi
    SHOW_JOURNAL=0
    message 'RPM installation complete; existing service state retained'
}

sysv_available() {
    if [ -f "$FILESYSTEM_ROOT/etc/rc.d/rc.M" ]; then return 0; fi
    [ -d "$FILESYSTEM_ROOT/etc/rc0.d" ] || return 1
    command -v update-rc.d >/dev/null 2>&1 || command -v chkconfig >/dev/null 2>&1
}

[ "$(id -u)" -eq 0 ] || fail 'run installer as root'
[ "$(uname -s)" = Linux ] || fail 'Linux with usable io_uring is required'
case "$(uname -m)" in x86_64) ARCHITECTURE=amd64 ;; aarch64|arm64) ARCHITECTURE=arm64 ;; *) fail 'supported architectures are amd64 and arm64' ;; esac
ID=''
ID_LIKE=''
VERSION_ID=''
if [ -r "$FILESYSTEM_ROOT/etc/os-release" ]; then . "$FILESYSTEM_ROOT/etc/os-release"; fi
case "$ID" in nixos|guix|guix-system) fail 'use supplied NixOS/Guix declarative integration; imperative FHS installation is not supported here' ;; esac
if [ -e "$FILESYSTEM_ROOT/run/ostree-booted" ]; then fail 'use image/layered integration for rpm-ostree; no live transaction attempted'; fi
if [ "$HTTPJET_INIT" = auto ]; then
    if [ -f "$FILESYSTEM_ROOT/var/lib/httpjet-installer/state.json" ] && command -v python3 >/dev/null 2>&1; then
        HTTPJET_INIT=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["init"])' "$FILESYSTEM_ROOT/var/lib/httpjet-installer/state.json")
    elif [ -d "$FILESYSTEM_ROOT/run/systemd/system" ] && command -v systemctl >/dev/null 2>&1; then HTTPJET_INIT=systemd
    elif [ -d "$FILESYSTEM_ROOT/run/openrc" ] && command -v rc-service >/dev/null 2>&1; then HTTPJET_INIT=openrc
    elif [ -d "$FILESYSTEM_ROOT/etc/runit" ] && command -v sv >/dev/null 2>&1 \
        && { [ "$(cat "$FILESYSTEM_ROOT/proc/1/comm" 2>/dev/null || :)" = runit ] || [ "$(cat "$FILESYSTEM_ROOT/proc/1/comm" 2>/dev/null || :)" = runsvdir ]; }; then HTTPJET_INIT=runit
    elif [ "$(cat "$FILESYSTEM_ROOT/proc/1/comm" 2>/dev/null || :)" = init ] && sysv_available; then HTTPJET_INIT=sysv
    else fail 'unknown init; use --init none for install-only and the foreground route'; fi
fi
case "$HTTPJET_INIT" in systemd|openrc|runit|sysv|none) ;; *) fail 'recorded init adapter is invalid' ;; esac
RPM_MANAGER=''
for candidate in dnf yum zypper; do if command -v "$candidate" >/dev/null 2>&1; then RPM_MANAGER=$candidate; break; fi; done
PACKAGE_BACKEND=''
case " $ID $ID_LIKE " in
    *debian*|*ubuntu*) if command -v apt-get >/dev/null 2>&1 && command -v dpkg >/dev/null 2>&1; then PACKAGE_BACKEND=apt; fi ;;
    *fedora*|*rhel*|*centos*|*suse*) if [ -n "$RPM_MANAGER" ] && command -v rpm >/dev/null 2>&1; then PACKAGE_BACKEND=rpm; fi ;;
esac
if [ "$HTTPJET_METHOD" = auto ]; then
    if [ -e "$FILESYSTEM_ROOT/var/lib/httpjet-installer/state.json" ]; then HTTPJET_METHOD=binary
    elif [ "$HTTPJET_INIT" = systemd ] && [ -n "$PACKAGE_BACKEND" ]; then HTTPJET_METHOD=package
    else HTTPJET_METHOD=binary; fi
fi
if [ "$HTTPJET_METHOD" = package ]; then
    [ ! -e "$FILESYSTEM_ROOT/var/lib/httpjet-installer/state.json" ] || fail 'generic installation owns httpjet; no automatic native takeover'
    [ "$HTTPJET_INIT" = systemd ] || fail 'native packages require systemd; choose --method binary for another init'
    if [ -z "$PACKAGE_BACKEND" ]; then
        if command -v apt-get >/dev/null 2>&1 && command -v dpkg >/dev/null 2>&1; then PACKAGE_BACKEND=apt
        elif [ -n "$RPM_MANAGER" ]; then PACKAGE_BACKEND=rpm
        else fail 'no supported native package manager; choose --method binary'; fi
    fi
    case "$PACKAGE_BACKEND" in apt) install_apt ;; rpm) install_rpm ;; esac
else
    install_binary
fi
