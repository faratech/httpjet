(define-module (httpjet packages)
  #:use-module (guix packages)
  #:use-module (guix download)
  #:use-module (guix build-system trivial)
  #:use-module (guix base16)
  #:use-module ((guix licenses) #:prefix license:)
  #:use-module (gnu packages base)
  #:use-module (gnu packages compression)
  #:use-module (ice-9 regex)
  #:use-module (srfi srfi-13)
  #:export (httpjet-binary-package))

;; Arguments come from the authenticated manifest lock generator.
(define* (httpjet-binary-package #:key release-id uri sha256 binary-sha256 system)
  (unless (and (string-match "^[0-9]+\\.[0-9]+\\.[0-9]+-[1-9][0-9]*$" release-id)
               (string-prefix? "https://" uri)
               (string-match "^[0-9a-f]{64}$" sha256)
               (string-match "^[0-9a-f]{64}$" binary-sha256)
               (member system '("x86_64-linux" "aarch64-linux")))
    (error "invalid hash-pinned httpjet release arguments"))
  (package
    (name "httpjet-bin") (version release-id)
    (source (origin (method url-fetch) (uri uri)
                    (sha256 (base16-string->bytevector sha256))))
    (build-system trivial-build-system)
    (arguments
     `(#:modules ((guix build utils))
       #:builder
       (begin
         (use-modules (guix build utils))
         (let* ((out (assoc-ref %outputs "out"))
                (source (assoc-ref %build-inputs "source"))
                (tar (string-append (assoc-ref %build-inputs "tar") "/bin/tar"))
                (gzip (string-append (assoc-ref %build-inputs "gzip") "/bin")))
           (setenv "PATH" gzip)
           (mkdir "unpack") (chdir "unpack")
           (invoke tar "xzf" source "--strip-components=1")
           (mkdir-p (string-append out "/bin"))
           (copy-file "bin/httpjet" (string-append out "/bin/httpjet"))
           (chmod (string-append out "/bin/httpjet") #o555)
           (copy-recursively "share" (string-append out "/share"))))))
    (native-inputs `(("tar" ,tar) ("gzip" ,gzip)))
    (supported-systems (list system))
    (home-page "https://httpjet.net")
    (synopsis "Hash-pinned static httpjet web server")
    (description "Copies a fully static release without changing its ELF bytes. The fixed origin hash binds the authenticated payload.")
    (license license:gpl3)))
