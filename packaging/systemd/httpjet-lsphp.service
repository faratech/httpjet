[Unit]
Description=httpjet persistent LSAPI pool
Documentation=https://github.com/faratech/httpjet
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=www-data
Group=www-data
RuntimeDirectory=httpjet
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/httpjet --root /etc/httpjet/litespeed lsphp --php-socket /run/httpjet/lsphp.sock --php-children 32 --control-socket /run/httpjet/lsphp-control.sock --generation-file /run/httpjet/lsphp.generation
ExecReload=/usr/bin/httpjet lsphp-reload --control-socket /run/httpjet/lsphp-control.sock --timeout-secs 90
Restart=on-failure
RestartSec=2
KillMode=mixed
TimeoutStartSec=90
TimeoutStopSec=90
LimitNOFILE=65536

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/httpjet

[Install]
WantedBy=multi-user.target
