[Unit]
Description=httpjet web server
Documentation=https://httpjet.net/docs/
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
User=httpjet
Group=httpjet
WorkingDirectory=/var/lib/httpjet
RuntimeDirectory=httpjet
RuntimeDirectoryMode=0750
StateDirectory=httpjet
StateDirectoryMode=0750
LogsDirectory=httpjet
LogsDirectoryMode=0750
Environment=HTTPJET_LOG_DIR=/var/log/httpjet
Environment=RUST_LOG=httpjet=info
ExecStartPre=/usr/bin/httpjet --root /etc/httpjet check --strict
ExecStart=/usr/bin/httpjet --root /etc/httpjet serve --http-addr 0.0.0.0:80 --https-addr= --metrics-addr= --no-php --no-multishot-accept
Restart=on-failure
RestartSec=2
TimeoutStartSec=30
TimeoutStopSec=30
KillMode=mixed
LimitNOFILE=65536
UMask=0027
StandardOutput=journal
StandardError=journal
SyslogIdentifier=httpjet

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
